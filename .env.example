# ---- Alan adları (DNS A kayıtları bu sunucuya işaret etmeli) ----
APP_DOMAIN=dagitim.odaadi.org.tr
KURYE_DOMAIN=kurye.odaadi.org.tr
REALTIME_DOMAIN=canli.odaadi.org.tr

# ---- Gizli değerler ----
POSTGRES_USER=dagitim
POSTGRES_PASSWORD=buraya-guclu-bir-sifre
POSTGRES_DB=dagitim
# openssl rand -base64 48
AUTH_SECRET=buraya-en-az-32-karakter-rastgele-deger

# ---- Uygulama ----
ODA_ADI=Ticaret Odası
# ---- Konum tahmini (geocoding) ----
# nominatim: ücretsiz OpenStreetMap (1 adres/sn, 5.000 adres ≈ 85 dk). google: GEOCODING_API_KEY gerekir (hızlı, ücretli). sahte: test.
GEOCODE_SAGLAYICI=nominatim
GEOCODING_API_KEY=
# Nominatim kullanım politikası için iletişim bilgisi içeren bir tanımlayıcı
NOMINATIM_USER_AGENT=dagitim-takip/1.0 (bilgi@odaadi.org.tr)

# ---- SMS ----
# sahte: gerçek gönderim yok (test). netgsm: Netgsm hesabı gerekir.
SMS_SAGLAYICI=sahte
NETGSM_USERCODE=
NETGSM_PASSWORD=
# Kuyruk işleyici ve rapor güncelleme için (openssl rand -hex 16)
CRON_KEY=degistir-cron-anahtari
